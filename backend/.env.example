# Configuración del entorno
ENVIRONMENT=production
PORT=8000

# Conexión a Neon PostgreSQL (con pooler y SSL obligatorio)
# Formato: postgresql://[usuario]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Orígenes permitidos para CORS (separados por coma, sin barra final)
ALLOWED_ORIGINS=https://umbra-radar.vercel.app,http://localhost:3000

# Expresión regular para previsualizaciones dinámicas de Vercel
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
